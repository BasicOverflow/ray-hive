# Used by examples/ and basic_ray_tests/ (via examples/.env) — not by the ray_hive package.
# Ray cluster
RAY_ADDRESS=ray://YOUR_RAY_HEAD_IP:10001
RAY_DASHBOARD_URL=http://YOUR_RAY_HEAD_IP:8265
# Ray Serve HTTP (OpenAI-compatible API). Defaults to http://<RAY_ADDRESS host>:8000 if unset.
RAY_SERVE_URL=http://YOUR_RAY_HEAD_IP:8000
# Optional. Named hive actors (gpu_registry, deploy_service) use this Ray namespace.
# Must match the VRAM monitor DaemonSet if you change it.
# RAY_HIVE_NAMESPACE=ray_hive
