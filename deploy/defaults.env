# Non-secret defaults for ray-hive supervisor LXC deploy on home-media.

CTID=119
CT_HOSTNAME=ray-hive-supervisor
CT_IP=10.0.0.59
CT_GW=10.0.0.1
CT_CIDR=16
BRIDGE=vmbr0
STORAGE=TN-VM-Backup
TEMPLATE_STORAGE=local
OSTEMPLATE=debian-12-standard_12.12-1_amd64.tar.zst
MEMORY=512
CORES=2
DISK_GB=8
UNPRIVILEGED=1
FEATURES=nesting=0
START_ON_BOOT=1
HA_GROUP=

APP_ROOT=/opt/ray-hive
APP_USER=hive
STATE_DIR=/var/lib/ray-hive
ENV_FILE=/etc/ray-hive.env

REPO_CLONE_URL=http://10.0.0.52:3000/admin/ray-hive.git
REPO_RAW_BASE=http://10.0.0.52:3000/admin/ray-hive/raw/branch/main
