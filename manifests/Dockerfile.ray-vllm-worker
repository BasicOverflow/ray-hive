# GPU Ray worker image: Ray + ffmpeg (torchcodec) + vLLM + ray-hive package.
# Official vLLM approach: apt packages live in the RUNTIME image.
#
# Build → verify → push (Docker host needs insecure-registries: ["10.0.0.52:3000"]):
#
#   # build the wheel first: py -3 -m build
#   IMG=10.0.0.52:3000/peter/ray-vllm-worker:2.56.0-vllm028-ocr2
#
#   docker build -f manifests/Dockerfile.ray-vllm-worker -t "$IMG" .
#
#   # AFTER build, BEFORE push (MSYS_NO_PATHCONV=1 required on Git Bash / Windows)
#   MSYS_NO_PATHCONV=1 docker run --rm "$IMG" python /opt/ray-hive/smoke_test_worker_deps.py
#   MSYS_NO_PATHCONV=1 docker run --rm "$IMG" pip check || true
#
#   docker push "$IMG"
#
# k3s nodes need plain-HTTP pull config — see manifests/k3s-registries-gitea.yaml
# and Homelab infrastructure/Gitea.md.

FROM rayproject/ray:2.56.0-py312-cu125

USER root
RUN apt-get update -qq \
    && apt-get install -y -qq --no-install-recommends \
        ffmpeg libsm6 libxext6 libgl1 libpulse0 \
    && rm -rf /var/lib/apt/lists/*

COPY manifests/smoke_test_worker_deps.py /opt/ray-hive/smoke_test_worker_deps.py
# Prebuilt wheel (py -m build) — avoid writing egg-info as non-root into a root COPY.
COPY dist/ray_hive-*.whl /tmp/

USER ray
# PyPI's default vllm wheel links CUDA 13 (libcudart.so.13). Use the cu129 build.
# numpy>=2.4 needs X86_V2 — pin <2.4 for Proxmox guest CPUs.
# pyOpenSSL/cryptography mismatch breaks Qwen3.5 import via boto3 (GEN_EMAIL).
# protobuf: vLLM wants >=5.29.6; Ray Serve breaks on 7.x — pin 5.29.6 after install.
# vLLM 0.28 pulls googleapis-common-protos>=1.75 (gencode 6.33) which then
# crashes Ray dashboard_agent on `from google.rpc import code_pb2`. Pin a 5.x
# gencode build so raylet can fate-share with the agent.
# FastAPI must match the Ray Client pin (ray_hive.core.ray_utils.session) — Serve
# ingress pickles FastAPI internals (_DefaultLifespan); skew → replica DEAD.
# DeepSeek-OCR / OCR-2 HF remote-code modeling needs addict + matplotlib (+ easydict).
# Smoke test is the build gate. `pip check` always screams on Ray+vLLM — run it advisory only.
ARG VLLM_VERSION=0.28.0
RUN pip install --no-cache-dir --upgrade "uv" \
    && uv pip install --system --no-cache --upgrade "scipy" \
        "https://github.com/vllm-project/vllm/releases/download/v${VLLM_VERSION}/vllm-${VLLM_VERSION}+cu129-cp38-abi3-manylinux_2_28_x86_64.whl" \
        --torch-backend=cu129 \
    && uv pip install --system --no-cache --upgrade "transformers" "numpy<2.4" "cryptography" "pyopenssl" \
        "fastapi==0.133.0" "starlette==1.0.1" \
        "addict" "matplotlib" "easydict" \
    && pip install --no-cache-dir --force-reinstall "protobuf==5.29.6" \
        "googleapis-common-protos==1.66.0" \
    && pip install --no-cache-dir --no-deps /tmp/ray_hive-*.whl \
    && python /opt/ray-hive/smoke_test_worker_deps.py \
    && python -c "from ray_hive.core.deployment import HIVE_DEPLOY_CODE_REV; assert HIVE_DEPLOY_CODE_REV >= 35"

ENV VLLM_VIDEO_LOADER_BACKEND=opencv
ENV HF_HOME=/home/ray/.cache/huggingface
